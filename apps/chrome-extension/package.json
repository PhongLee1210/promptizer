{
  "name": "@promptizer/chrome-extension",
  "private": true,
  "version": "0.1.2",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && bash scripts/assert-manifest.sh",
    "zip": "wxt zip && bash scripts/assert-manifest.sh",
    "test": "vitest run",
    "test:e2e": "./e2e/with-test-build.sh",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@promptizer/shared": "workspace:*",
    "@promptizer/ui": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "puppeteer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wxt": "catalog:"
  }
}
