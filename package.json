    "happy-dom": "^20.14.6",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
